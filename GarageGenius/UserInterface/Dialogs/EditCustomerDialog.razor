@using GarageGenius.Common.Models
@using GarageGenius.UserInterface.Components

<style>
    .selected > td {
        color: white !important;
    }
</style>

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_editedCustomerName" Label="Name" Variant="Variant.Text"></MudTextField>
        <MudTextField @bind-Value="_editedCustomerNote" Label="Notiz" Variant="Variant.Text"></MudTextField>
        <MudText Typo="Typo.h6" Class="mt-4 mb-2">Fahrzeuge</MudText>

        <MudCollapse Expanded="!_showVehicleForm">
            <MudPaper>
                <MudTable T="Vehicle" Items="@_vehicles"
                          Hover="true"
                          Dense="true"
                          FixedHeader="true"
                          Height="200px"
                          @ref="_mudTable"
                          RowClass="cursor-pointer"
                          RowClassFunc="@SelectedRowClassFunc"
                          OnRowClick="RowClickEvent">
                    <HeaderContent>
                        <MudTh>Marke</MudTh>
                        <MudTh>Modell</MudTh>
                        <MudTh>Kennzeichen</MudTh>
                        <MudTh>Notizen</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Marke">@context.Brand</MudTd>
                        <MudTd DataLabel="Modell">@context.Model</MudTd>
                        <MudTd DataLabel="Kennzeichen">@context.LicensePlate</MudTd>
                        <MudTd DataLabel="Notizen">@context.Notes</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>Keine Fahrzeuge vorhanden</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudCollapse>
        <div class="d-flex justify-content-center mt-3 gap-2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddVehicle">
                Hinzufügen
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Remove"
                       OnClick="RemoveSelectedVehicle"
                       Disabled="@(_selectedVehicle == null)">
                Entfernen
            </MudButton>
        </div>

        <MudCollapse Expanded="_showVehicleForm" Class="mt-4">
            <VehicleFormComponent @bind-Vehicle="_newVehicle"
                                  OnConfirm="ConfirmAddVehicle"
                                  OnCancel="CancelAddVehicle"
                                  ConfirmButtonText="Fahrzeug hinzufügen"
                                  CancelButtonText="Abbrechen"/>
        </MudCollapse>

        <MudButton OnClick="SubmitChanges" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                   Color="Color.Primary">
            Speichern
        </MudButton>
        <MudButton OnClick="CancelChanges" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Cancel"
                   Color="Color.Secondary">
            Abbrechen
        </MudButton>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public Customer? Customer { get; set; }
    private string? _editedCustomerName;
    private string? _editedCustomerNote;
    private List<Vehicle> _vehicles = new();
    private Vehicle? _selectedVehicle;

    private int _selectedRowNumber = -1;
    private MudTable<Vehicle>? _mudTable;

    private bool _showVehicleForm;
    private Vehicle _newVehicle = new();

    protected override void OnInitialized()
    {
        if (Customer == null) return;
        _editedCustomerName = Customer.Name;
        _editedCustomerNote = Customer.Note;
        _vehicles = Customer.Vehicles.ToList();
    }

    private void RowClickEvent(TableRowClickEventArgs<Vehicle> tableRowClickEventArgs)
    {
        _selectedVehicle = tableRowClickEventArgs.Item;
        StateHasChanged();
    }

    private string SelectedRowClassFunc(Vehicle vehicle, int rowNumber)
    {
        if (_selectedRowNumber == rowNumber)
        {
            _selectedRowNumber = -1;
            _selectedVehicle = null;
            return string.Empty;
        }

        if (_mudTable?.SelectedItem == null || !_mudTable.SelectedItem.Equals(vehicle)) return string.Empty;

        _selectedRowNumber = rowNumber;
        _selectedVehicle = vehicle;
        return "selected";
    }

    private void AddVehicle()
    {
        _showVehicleForm = true;
    }

    private void ConfirmAddVehicle()
    {
        var vehicleToAdd = new Vehicle
        {
            LicensePlate = _newVehicle.LicensePlate,
            Brand = _newVehicle.Brand,
            Model = _newVehicle.Model,
            ChassisNumber = _newVehicle.ChassisNumber,
            Notes = _newVehicle.Notes,
            CustomerId = Customer?.Id ?? 0
        };

        _vehicles.Add(vehicleToAdd);
        _selectedVehicle = vehicleToAdd;
        _showVehicleForm = false;

        _newVehicle.LicensePlate = null;
        _newVehicle.Brand = null;
        _newVehicle.Model = null;
        _newVehicle.ChassisNumber = null;
        _newVehicle.Notes = null;
        StateHasChanged();
    }

    private void CancelAddVehicle()
    {
        _showVehicleForm = false;

        _newVehicle.LicensePlate = null;
        _newVehicle.Brand = null;
        _newVehicle.Model = null;
        _newVehicle.ChassisNumber = null;
        _newVehicle.Notes = null;
        StateHasChanged();
    }

    private void RemoveSelectedVehicle()
    {
        if (_selectedVehicle == null || !_vehicles.Contains(_selectedVehicle)) return;

        _vehicles.Remove(_selectedVehicle);
        _selectedVehicle = null;
        _selectedRowNumber = -1;
        StateHasChanged();
    }

    private void SubmitChanges()
    {
        if (Customer == null)
            throw new ArgumentNullException(nameof(Customer));

        if (!string.IsNullOrEmpty(_editedCustomerName) && !Customer.Name!.Equals(_editedCustomerName))
            Customer.Name = _editedCustomerName;

        if (!string.IsNullOrEmpty(_editedCustomerNote) && !Customer.Note!.Equals(_editedCustomerNote))
            Customer.Note = _editedCustomerNote;

        if (_vehicles.Any())
            Customer.Vehicles = _vehicles.ToList();

        MudDialog?.Close(DialogResult.Ok(Customer));
    }

    private void CancelChanges() => MudDialog?.Close(DialogResult.Cancel());
}