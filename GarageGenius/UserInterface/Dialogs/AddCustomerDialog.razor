@using GarageGenius.Common.Models
@using GarageGenius.UserInterface.Components

<MudDialog>
    <TitleContent>
        Kunde erstellen
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudPaper>
                    <MudTextField @bind-Value="_newCustomer.Name" Label="Kundenname" Variant="Variant.Outlined"/>
                    <MudTextField @bind-Value="_newCustomer.Note" Label="Notiz" Variant="Variant.Outlined"/>
                    <MudList T="Vehicle" Dense="true" @bind-SelectedValue="_selectedVehicle">
                        <MudListSubheader>Fahrzeuge</MudListSubheader>
                        @if (_newCustomer.Vehicles.Count == 0)
                        {
                            <MudListItem T="Vehicle" Disabled="true">
                                <MudText Typo="Typo.body2" Color=Color.Secondary>Keine Fahrzeuge hinzugefügt.</MudText>
                            </MudListItem>
                        }
                        else
                        {
                            @foreach (var v in _newCustomer.Vehicles.ToList())
                            {
                                <MudListItem T="Vehicle" Value="@v">
                                    <ChildContent>
                                        <MudStack Row="true" AlignItems=AlignItems.Center Justify=Justify.SpaceBetween
                                                  Class="w-100">
                                            <MudText>@(v.LicensePlate ?? "Fahrzeug")</MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           OnClick="@(() => RemoveVehicle(v))">
                                                Fahrzeug entfernen
                                            </MudIconButton>
                                        </MudStack>
                                    </ChildContent>
                                </MudListItem>
                            }
                        }
                    </MudList>
                    <MudStack Row="true" Spacing="2" Class="mt-2">
                        <MudButton Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined" OnClick="ShowVehicleForm">
                            Fahrzeug hinzufügen
                        </MudButton>

                        <MudButton Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined"
                                   Disabled="@(_selectedVehicle is null)"
                                   OnClick="@(() => RemoveVehicle(_selectedVehicle))">
                            Fahrzeug entfernen
                        </MudButton>
                    </MudStack>

                    <MudCollapse Expanded="_showVehicleForm" Class="mt-4">
                        <VehicleFormComponent @bind-Vehicle="_newVehicle"
                                            OnConfirm="ConfirmAddVehicle"
                                            OnCancel="CancelAddVehicle"
                                            ConfirmButtonText="Fahrzeug übernehmen"
                                            CancelButtonText="Abbrechen" />
                    </MudCollapse>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly Customer _newCustomer = new();
    private Vehicle? _selectedVehicle;
    private bool _showVehicleForm;
    private Vehicle _newVehicle = new();
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    
    private void ShowVehicleForm()
    {
        _showVehicleForm = true;
    }

    private void ConfirmAddVehicle()
    {
        var vehicleToAdd = new Vehicle
        {
            LicensePlate = _newVehicle.LicensePlate,
            Brand = _newVehicle.Brand,
            Model = _newVehicle.Model,
            ChassisNumber = _newVehicle.ChassisNumber,
            Notes = _newVehicle.Notes
        };
        
        _newCustomer.Vehicles.Add(vehicleToAdd);
        _selectedVehicle = vehicleToAdd;
        _showVehicleForm = false;
        
        _newVehicle.LicensePlate = null;
        _newVehicle.Brand = null;
        _newVehicle.Model = null;
        _newVehicle.ChassisNumber = null;
        _newVehicle.Notes = null;
        
        StateHasChanged();
    }

    private void CancelAddVehicle()
    {
        _showVehicleForm = false;
        
        _newVehicle.LicensePlate = null;
        _newVehicle.Brand = null;
        _newVehicle.Model = null;
        _newVehicle.ChassisNumber = null;
        _newVehicle.Notes = null;
        
        StateHasChanged();
    }

    private void RemoveVehicle(Vehicle? vehicle)
    {
        if (vehicle is null) return;

        _newCustomer.Vehicles.Remove(vehicle);
        if (_selectedVehicle == vehicle)
            _selectedVehicle = null;
        StateHasChanged();
    }
    
    private void Submit() => MudDialog?.Close(DialogResult.Ok(_newCustomer));
    private void Cancel() => MudDialog?.Close(DialogResult.Cancel());
}