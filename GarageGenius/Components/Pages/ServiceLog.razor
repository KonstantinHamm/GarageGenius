@page "/servicelog"
@using System.Globalization

<MudPaper Width="100%">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid>
            <MudItem xs="2">
                <MudPaper Style="height:90vh;">
                    <MudTextField @bind-Value="customerSearch" Placeholder="Kunde suchen..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"/>
                    <MudList T="Customer">
                        @foreach (var customer in FilteredCustomers)
                        {
                            <MudListItem T="Customer" Selected="@(_selectedCustomer == customer)"
                                         @onclick="() => SelectCustomer(customer)">
                                <ChildContent>
                                    <div>@customer.Name</div>
                                    <div style="font-size:x-small;color:gray;">@customer.Description</div>
                                </ChildContent>
                            </MudListItem>
                        }
                    </MudList>

                </MudPaper>
            </MudItem>
            <MudItem xs="2">
                <MudPaper Style="height:90vh;">
                    <MudDatePicker @bind-Date="serviceFilterDate" Label="Nach Datum filtern" DateFormat="dd.MM.yyyy"
                                   Clearable="true"/>
                    <MudList T="ServiceVisit">
                        @if (_selectedCustomer != null)
                        {
                            @foreach (var visit in FilteredVisits)
                            {
                                <MudListItem T="ServiceVisit" Selected="@(_selectedVisit == visit)"
                                             @onclick="() => SelectVisit(visit)">
                                    <ChildContent>
                                        <div>@visit.Date.ToString("dd.MM.yyyy")</div>
                                        <div style="font-size:x-small;color:gray;">@visit.Reason</div>
                                    </ChildContent>
                                </MudListItem>
                            }
                        }
                    </MudList>

                </MudPaper>
            </MudItem>
            <MudItem xs="8">
                <MudPaper Style="height:90vh;">
                    @if (_selectedVisit != null)
                    {
                        <h3>Dokumentation: @(_selectedVisit.Date.ToString("dd.MM.yyyy"))</h3>
                        <div>@_selectedVisit.Notes</div>
                        <MudGrid>
                            @foreach (var img in _selectedVisit.Images)
                            {
                                <MudItem xs="2">
                                    <MudImage Src="@img" Style="max-width:100%;max-height:120px;"/>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <p>Bitte einen Werkstattaufenthalt auswählen.</p>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudPaper>

@code {
    public class Customer
    {
        public string Name { get; set; }
        public string Description { get; set; }
        public List<ServiceVisit> Visits { get; set; } = new();
    }

    public class ServiceVisit
    {
        public DateTime Date { get; set; }
        public string Reason { get; set; }
        public string Notes { get; set; }
        public List<string> Images { get; set; } = new();
    }

    List<Customer> customers = new()
    {
        new Customer
        {
            Name = "Max Mustermann", Description = "Audi A4, Baujahr 2020", Visits = new()
            {
                new ServiceVisit { Date = DateTime.Now.AddDays(-130), Reason = "Routine Service", Notes = "Ölwechsel etc.", Images = new() { "images/felge1.jpg", "images/kotfluegel1.jpg" } },
                new ServiceVisit { Date = DateTime.Now.AddDays(-12), Reason = "Reifenwechsel", Notes = "Winterreifen montiert.", Images = new() { "images/reifen1.jpg" } }
            }
        },
        new Customer
        {
            Name = "Erika Beispiel", Description = "VW Golf 7, BJ 2018", Visits = new()
            {
                new ServiceVisit { Date = DateTime.Now.AddDays(-30), Reason = "Inspektion", Notes = "Bremsen erneuert.", Images = new() { "images/bremse1.jpg", "images/kotfluegel2.jpg" } }
            }
        }
    };

    Customer _selectedCustomer;
    ServiceVisit _selectedVisit;

    string customerSearch;
    DateTime? serviceFilterDate;

    IEnumerable<Customer> FilteredCustomers =>
        string.IsNullOrWhiteSpace(customerSearch)
            ? customers
            : customers.Where(c =>
                c.Name.Contains(customerSearch, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrEmpty(c.Description) && c.Description.Contains(customerSearch, StringComparison.OrdinalIgnoreCase)));

    IEnumerable<ServiceVisit> FilteredVisits =>
        _selectedCustomer?.Visits
            .Where(v => !serviceFilterDate.HasValue || v.Date.Date == serviceFilterDate.Value.Date)
        ?? [];

    void SelectCustomer(Customer c)
    {
        _selectedCustomer = c;
        _selectedVisit = null;
        serviceFilterDate = null;
    }

    void SelectVisit(ServiceVisit visit)
    {
        _selectedVisit = visit;
    }
}