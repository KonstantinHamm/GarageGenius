@page "/servicelog"
@using GarageGenius.Common.Data
@using GarageGenius.Common.Models

@inject ICustomerRepository CustomerRepo

<MudPaper Width="100%">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid>
            <MudItem xs="2">
                <MudPaper Style="height:90vh;">
                    <MudTextField @bind-Value="_customerSearch" Placeholder="Kunde suchen..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"/>
                    <MudList T="Customer">
                        @foreach (var customer in FilteredCustomers)
                        {
                            <MudListItem T="Customer" Selected="@(_selectedCustomer == customer)"
                                         @onclick="() => SelectCustomer(customer)">
                                <ChildContent>
                                    <div>@customer.Name</div>
                                    <div style="font-size:x-small;color:gray;">@customer.Note</div>
                                </ChildContent>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            </MudItem>
            <MudItem xs="2">
                <MudPaper Style="height:90vh;">
                    <MudDatePicker @bind-Date="_serviceFilterDate" Label="Nach Datum filtern" DateFormat="dd.MM.yyyy"
                                   Clearable="true"/>
                    <MudList T="ServiceVisit">
                        @if (_selectedCustomer != null)
                        {
                            @foreach (var visit in FilteredVisits)
                            {
                                <MudListItem T="ServiceVisit" Selected="@(_selectedVisit == visit)"
                                             @onclick="() => SelectVisit(visit)">
                                    <ChildContent>
                                        <div>@visit.EntryDate.ToString("dd.MM.yyyy")</div>
                                        <div style="font-size:x-small;color:gray;">@visit.Reason</div>
                                    </ChildContent>
                                </MudListItem>
                            }
                        }
                    </MudList>
                </MudPaper>
            </MudItem>
            <MudItem xs="8">
                <MudPaper Style="height:90vh;">
                    @if (_selectedVisit != null)
                    {
                        <h3>Dokumentation: @(_selectedVisit.EntryDate.ToString("dd.MM.yyyy"))</h3>
                        <div>
                            <b>Kunde:</b> @_selectedCustomer?.Name
                        </div>
                        <div>
                            <b>Grund:</b> @_selectedVisit.Reason
                        </div>
                        @if (_selectedVisit.Vehicle != null)
                        {
                            <div>
                                <b>Fahrzeug:</b> @_selectedVisit.Vehicle.Brand @_selectedVisit.Vehicle.Model
                                @_selectedVisit.Vehicle.ChassisNumber @_selectedVisit.Vehicle.LicensePlate
                            </div>
                        }
                        <div>@_selectedVisit.Notes</div>
                        <MudGrid>
                            @foreach (var img in _selectedVisit.Images)
                            {
                                @* <MudItem xs="2"> *@
                                @*     <MudImage Src="@" Style="max-width:100%;max-height:120px;"/> *@
                                @* </MudItem> *@
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <p>Bitte einen Werkstattaufenthalt auswählen.</p>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudPaper>

@code {
    readonly List<Customer> _customers =
    [
        new()
        {
            Name = "Max Mustermann", Note = "Sohn von Alois Mustermann", Visits = new()
            {
                new ServiceVisit { EntryDate = DateTime.Now.AddDays(-130), Reason = "Routine Service", Notes = "Ölwechsel etc.", Vehicle = new Vehicle
                {
                    Brand = "VW",
                    Model = "Golf 4",
                    ChassisNumber = "W0L000051T2123456",
                    LicensePlate = "MK-MM 1234",
                    Notes = "Achtung liegt tiefer als Oma! Bitte Auffahrrampe verwenden"
                },Images = new List<WorkshopLogEntryImage>() { } },
                new ServiceVisit { EntryDate = DateTime.Now.AddDays(-12), Reason = "Reifenwechsel", Notes = "Winterreifen montiert.", Images = new List<WorkshopLogEntryImage>() { } }
            }
        },

        new()
        {
            Name = "Erika Beispiel", Note = "-", Visits =
            [
                new ServiceVisit
                {
                    EntryDate = DateTime.Now.AddDays(-30), Reason = "Inspektion", Notes = "Bremsen erneuert.", Vehicle = new Vehicle()
                    {
                        Brand = "Toyota",
                        Model = "Yaris",
                        ChassisNumber = "TOY000051T234356645",
                        LicensePlate = "MK-EB 234",
                        Notes = "Nicht vorhanden im Bosch-System. Toyota-Prüfsoftware verwenden."
                    },
                    Images = new List<WorkshopLogEntryImage>() { }
                }
            ]
        }
    ];

    Customer? _selectedCustomer;
    ServiceVisit? _selectedVisit;
    string? _customerSearch;
    DateTime? _serviceFilterDate;

    protected override async Task OnInitializedAsync()
    {
        var customers = await CustomerRepo.GetCustomersWithVisitsAsync();
    }
    
    IEnumerable<Customer> FilteredCustomers =>
        string.IsNullOrWhiteSpace(_customerSearch)
            ? _customers
            : _customers.Where(c =>
                c.Name != null && (c.Name.Contains(_customerSearch, 
                                       StringComparison.OrdinalIgnoreCase) ||
                                        (!string.IsNullOrEmpty(c.Note) &&
                                        c.Note.Contains(_customerSearch, 
                                            StringComparison.OrdinalIgnoreCase))));

    IEnumerable<ServiceVisit> FilteredVisits =>
        _selectedCustomer?.Visits
            .Where(v => !_serviceFilterDate.HasValue ||
                        v.EntryDate.Date == _serviceFilterDate.Value.Date) ?? [];

    void SelectCustomer(Customer c)
    {
        _selectedCustomer = c;
        _selectedVisit = null;
        _serviceFilterDate = null;
    }

    void SelectVisit(ServiceVisit visit)
    {
        _selectedVisit = visit;
    }
}