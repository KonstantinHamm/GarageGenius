@implements IDisposable

@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory

<MudNavMenu Bordered="true" Margin="Margin.Normal" Rounded="true">
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.DashboardCustomize" Match="NavLinkMatch.All">
                Dashboard
            </MudNavLink>
            <MudNavGroup Title="Nachweise" Expanded="false" Icon="@Icons.Material.Filled.Policy">
                <MudNavLink Href="/servicelog" Icon="@Icons.Material.Filled.History" Match="NavLinkMatch.Prefix">
                    Übersicht
                </MudNavLink>
                <MudNavLink Href="/search_records" Icon="@Icons.Material.Filled.Search" Match="NavLinkMatch.Prefix">
                    Suche
                </MudNavLink>
            </MudNavGroup>
            <MudNavLink Href="/devices" Icon="@Icons.Material.Filled.PhoneAndroid" Match="NavLinkMatch.Prefix">Mobile
                Geräte
            </MudNavLink>
            <MudNavGroup Title="Einstellungen" Expanded="false" Icon="@Icons.Material.Filled.Settings">
                <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.SettingsApplications"
                            Match="NavLinkMatch.Prefix">App-Einstellungen
                </MudNavLink>
                <MudNavLink Href="/manage_account" Icon="@Icons.Material.Filled.ManageAccounts" Match="NavLinkMatch.Prefix">
                    Account
                </MudNavLink>
            </MudNavGroup>

            <form action="/logout" method="post">
                <AntiforgeryToken/>
                <input type="hidden" name="ReturnUrl" value=""/>
                <button type="submit" class="mud-nav-link mud-ripple">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Info" Class="mr-3"></MudIcon> Logout
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">Home</MudNavLink>
            <MudNavLink Href="/Account/Login" Icon="@Icons.Material.Filled.Login" Match="NavLinkMatch.Prefix">Login
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private string? _currentUrl;

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private async Task Logout()
    {
        // var client = HttpClientFactory.CreateClient();
        // client.BaseAddress = new Uri(NavigationManager.BaseUri); 
        // await client.PostAsync("/logout", null);
        // NavigationManager.NavigateTo("/", forceLoad: true);
    }
    
    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}