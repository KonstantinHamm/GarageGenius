@using GarageGenius.Components.Themes
@inherits LayoutComponentBase

<MudThemeProvider Theme="BootsWatchYeti.YetiTheme" IsDarkMode="@ToggleDarkMode"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudSpacer />
        <MudSwitch @bind-Value="ToggleDarkMode" ThumbIcon="@(ToggleDarkMode ? Icons.Material.Filled.NightsStay : 
    Icons.Material.Filled.LightMode)" ThumbIconColor="@(ToggleDarkMode ? Color.Success : Color.Warning)">Dark/Bright</MudSwitch>

    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">GaragePal</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-16 pt-16">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    public bool ToggleDarkMode { get; set; } = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override void OnInitialized()
    {
        StateHasChanged();
    }
}