@using GarageGenius.Common.Models
<MudDialog>
    <TitleContent>
        Kunde erstellen
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_newCustomer.Name" Label="Kundenname" Variant="Variant.Outlined"/>
                <MudTextField @bind-Value="_newCustomer.Note" Label="Notiz" Variant="Variant.Outlined"/>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly Customer _newCustomer = new();
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    private void Submit() => MudDialog?.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog?.Cancel();
}